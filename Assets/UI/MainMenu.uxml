<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Settings" src="Settings.uxml" />
    <!-- Styles come from the panel theme (MenuTheme.tss imports MainMenu.uss), so popups like dropdown lists match too. -->
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="shade" class="shade" picking-mode="Ignore" />
        <ui:VisualElement name="vignette" class="vignette" picking-mode="Ignore" />
        <ui:VisualElement name="embers" class="embers" picking-mode="Ignore" />

        <ui:VisualElement name="main" class="main">
            <ui:VisualElement name="title-block" class="title-block hidden-up">
                <ui:VisualElement class="kicker-row">
                    <ui:VisualElement class="kicker-line" />
                    <ui:Label text="#menu.kicker" class="kicker" />
                    <ui:VisualElement class="kicker-line kicker-line--right" />
                </ui:VisualElement>
                <ui:Label name="title" class="title" text="#menu.title" />
                <ui:VisualElement class="divider">
                    <ui:VisualElement class="divider-line" />
                    <ui:VisualElement class="gem" />
                    <ui:VisualElement class="divider-line divider-line--right" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="buttons" class="buttons">
                <ui:Button name="play" text="#menu.play" class="menu-btn menu-btn--primary hidden-left"><ui:VisualElement class="btn-gem" /></ui:Button>
                <ui:Button name="levels" text="#menu.levels" class="menu-btn hidden-left"><ui:VisualElement class="btn-gem" /></ui:Button>
                <ui:Button name="howto" text="#menu.howto" class="menu-btn hidden-left"><ui:VisualElement class="btn-gem" /></ui:Button>
                <ui:Button name="settings" text="#menu.settings" class="menu-btn hidden-left"><ui:VisualElement class="btn-gem" /></ui:Button>
                <ui:Button name="credits" text="#menu.credits" class="menu-btn hidden-left"><ui:VisualElement class="btn-gem" /></ui:Button>
                <ui:Button name="quit" text="#menu.quit" class="menu-btn menu-btn--quiet hidden-left"><ui:VisualElement class="btn-gem" /></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="scrim" class="scrim" />

        <ui:Instance template="Settings" class="overlay" picking-mode="Ignore" />

        <!-- Levels -->
        <ui:VisualElement name="levels-panel" class="panel">
            <ui:VisualElement class="frame">
                <ui:VisualElement class="stud stud--tl" /><ui:VisualElement class="stud stud--tr" /><ui:VisualElement class="stud stud--bl" /><ui:VisualElement class="stud stud--br" />
                <ui:Label text="#levels.title" class="panel-title" />
                <ui:VisualElement name="stars-total" class="stars-total" picking-mode="Ignore" />
                <ui:VisualElement name="level-grid" class="level-grid" />
                <ui:VisualElement class="panel-footer">
                    <ui:Button name="reset-progress" text="#levels.reset" class="small-btn small-btn--quiet" />
                    <ui:Button text="#back" class="small-btn back-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- How to Play -->
        <ui:VisualElement name="howto-panel" class="panel">
            <ui:VisualElement class="frame frame--tall">
                <ui:VisualElement class="stud stud--tl" /><ui:VisualElement class="stud stud--tr" /><ui:VisualElement class="stud stud--bl" /><ui:VisualElement class="stud stud--br" />
                <ui:Label text="#howto.title" class="panel-title" />
                <ui:VisualElement class="steps">
                    <ui:VisualElement class="step">
                        <ui:Label text="1" class="step-num" />
                        <ui:Label text="#howto.1.title" class="step-title" />
                        <ui:Label name="howto-1" text="#howto.1.body" class="step-body" />
                    </ui:VisualElement>
                    <ui:VisualElement class="step">
                        <ui:Label text="2" class="step-num" />
                        <ui:Label text="#howto.2.title" class="step-title" />
                        <ui:Label text="#howto.2.body" class="step-body" />
                    </ui:VisualElement>
                    <ui:VisualElement class="step">
                        <ui:Label text="3" class="step-num" />
                        <ui:Label text="#howto.3.title" class="step-title" />
                        <ui:Label text="#howto.3.body" class="step-body" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView class="pieces" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement class="pieces-grid">
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--potion" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.potion.title" class="step-title" />
                            <ui:Label text="#howto.potion.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--sleep" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.sleep.title" class="step-title" />
                            <ui:Label text="#howto.sleep.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--recall" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.recall.title" class="step-title" />
                            <ui:Label text="#howto.recall.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--rage" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.rage.title" class="step-title" />
                            <ui:Label text="#howto.rage.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--stone" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.stone.title" class="step-title" />
                            <ui:Label text="#howto.stone.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--dwarf" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.dwarf.title" class="step-title" />
                            <ui:Label text="#howto.dwarf.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--brute" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.brute.title" class="step-title" />
                            <ui:Label text="#howto.brute.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--wizard" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.wizard.title" class="step-title" />
                            <ui:Label text="#howto.wizard.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--thief" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.thief.title" class="step-title" />
                            <ui:Label text="#howto.thief.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--hunter" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.hunter.title" class="step-title" />
                            <ui:Label text="#howto.hunter.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="piece">
                        <ui:VisualElement class="piece-icon piece-icon--ward" />
                        <ui:VisualElement class="piece-text">
                            <ui:Label text="#howto.ward.title" class="step-title" />
                            <ui:Label text="#howto.ward.body" class="step-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement class="panel-footer"><ui:Button text="#back" class="small-btn back-btn" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Credits -->
        <ui:VisualElement name="credits-panel" class="panel">
            <ui:VisualElement class="frame frame--narrow">
                <ui:VisualElement class="stud stud--tl" /><ui:VisualElement class="stud stud--tr" /><ui:VisualElement class="stud stud--bl" /><ui:VisualElement class="stud stud--br" />
                <ui:Label text="#credits.title" class="panel-title" />
                <ui:VisualElement class="credits">
                    <ui:Label text="#credits.by" class="credit-role" />
                    <ui:Label text="#credits.name" class="credit-name" />
                    <ui:Label text="#credits.fonts" class="credit-role" />
                    <ui:Label text="#credits.fonts.who" class="credit-name credit-name--small" />
                    <ui:Label text="#credits.art" class="credit-role" />
                    <ui:Label text="#credits.art.who" class="credit-name credit-name--small" />
                    <ui:Label text="#credits.madefor" class="credit-role" />
                    <ui:Label text="#credits.madefor.who" class="credit-name credit-name--small" />
                </ui:VisualElement>
                <ui:VisualElement class="panel-footer"><ui:Button text="#back" class="small-btn back-btn" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
