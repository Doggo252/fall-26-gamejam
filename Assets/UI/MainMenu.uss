/* The UNchosen ONE: main menu look. Stone plaques, gold trim, blood red accents. */

:root {
    --ink: #0D0B10;
    --stone: rgba(24, 20, 28, 0.88);
    --stone-hi: rgba(58, 36, 30, 0.94);
    --edge: #4A4250;
    --gold: #D9A441;
    --gold-hi: #F3D27A;
    --blood: #B3261E;
    --ember: #FF7A2F;
    --text: #EFE6D2;
    --muted: #A89F8C;
}

.root, .unity-base-dropdown {
    -unity-font-definition: url("Fonts/Cinzel-SemiBold.ttf");
    color: var(--text);
}

.root {
    flex-grow: 1;
}

/* ---------- Background layers ---------- */

.shade, .vignette, .embers, .scrim, .fade {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.shade {
    right: 35%;
    -unity-background-scale-mode: stretch-to-fill;
}

.vignette {
    -unity-background-scale-mode: stretch-to-fill;
}

.ember {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: var(--ember);
}

.fade {
    background-color: #000000;
    opacity: 1;
    transition: opacity 1.1s ease-in-out;
}

.fade--clear {
    opacity: 0;
}

/* ---------- Intro states (removed by MainMenu.cs one by one) ---------- */

.hidden-up { opacity: 0; translate: 0 -50px; }
.hidden-left { opacity: 0; translate: -90px 0; }
.hidden-fade { opacity: 0; }
.hidden-pop { opacity: 0; scale: 0.6 0.6; }

/* ---------- Title ---------- */

.main {
    position: absolute;
    left: 130px; top: 0; bottom: 0;
    justify-content: center;
}

.title-block {
    margin-bottom: 46px;
    transition: opacity 0.9s ease-out, translate 0.9s ease-out-back;
}

.kicker-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: -18px;
    margin-left: 8px;
}

.kicker {
    -unity-font-definition: url("Fonts/Cinzel-ExtraBold.ttf");
    font-size: 30px;
    letter-spacing: 14px;
    color: var(--gold);
    margin: 0 14px;
    padding: 0;
}

.kicker-line {
    width: 70px;
    height: 2px;
    background-color: var(--gold);
    opacity: 0.7;
}

.kicker-line--right {
    width: 220px;
}

.title {
    -unity-font-definition: url("Fonts/CinzelDecorative-Black.ttf");
    font-size: 118px;
    color: var(--text);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #120E14;
    text-shadow: 0 7px 14px rgba(0, 0, 0, 0.9);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
    transition: text-shadow 2.4s ease-in-out, letter-spacing 1.4s ease-out-cubic;
}

.title--wide {
    letter-spacing: 26px;
}

.title--glow {
    text-shadow: 0 0 26px rgba(255, 80, 30, 0.8);
}

.divider {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-left: 8px;
}

.divider-line {
    width: 300px;
    height: 2px;
    background-color: var(--gold);
    opacity: 0.6;
}

.divider-line--right {
    width: 120px;
}

.gem {
    width: 14px;
    height: 14px;
    margin: 0 12px;
    rotate: 45deg;
    background-color: var(--blood);
    border-width: 2px;
    border-color: var(--gold);
}

/* ---------- Main buttons ---------- */

.buttons {
    align-items: flex-start;
}

.menu-btn {
    width: 440px;
    height: 62px;
    margin: 0 0 12px 0;
    padding: 0 0 0 30px;
    -unity-font-definition: url("Fonts/Cinzel-ExtraBold.ttf");
    font-size: 26px;
    letter-spacing: 5px;
    -unity-text-align: middle-left;
    color: var(--text);
    background-color: var(--stone);
    border-width: 2px;
    border-left-width: 6px;
    border-color: var(--edge);
    border-left-color: var(--gold);
    border-radius: 3px;
    transition: translate 0.45s ease-out-back, opacity 0.45s ease-out, background-color 0.18s ease-out,
                border-color 0.18s ease-out, color 0.18s ease-out, scale 0.1s ease-out, width 0.25s ease-out-cubic;
}

.menu-btn:hover, .menu-btn:focus {
    translate: 16px 0;
    width: 470px;
    color: var(--gold-hi);
    background-color: var(--stone-hi);
    border-color: var(--gold);
    border-left-color: var(--gold-hi);
}

.menu-btn:active {
    scale: 0.97 0.97;
}

.menu-btn--primary {
    height: 76px;
    font-size: 32px;
    background-color: rgba(92, 24, 20, 0.92);
    border-color: var(--gold);
    border-left-color: var(--blood);
    margin-bottom: 20px;
}

.menu-btn--primary:hover, .menu-btn--primary:focus {
    background-color: rgba(140, 34, 26, 0.96);
    border-left-color: var(--gold-hi);
}

.menu-btn--quiet {
    color: var(--muted);
    border-left-color: var(--edge);
}

.btn-gem {
    position: absolute;
    right: 24px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    rotate: 45deg;
    background-color: var(--edge);
    transition: background-color 0.2s ease-out, scale 0.3s ease-out-back, rotate 0.4s ease-out-cubic;
}

.menu-btn:hover .btn-gem, .menu-btn:focus .btn-gem {
    background-color: var(--gold-hi);
    scale: 1.5 1.5;
    rotate: 225deg;
}

/* ---------- Panels ---------- */

.scrim {
    display: none;
    background-color: rgba(5, 3, 8, 0.72);
    opacity: 0;
    transition: opacity 0.3s ease-out;
}

.scrim--on { opacity: 1; }

.panel {
    display: none;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.frame {
    width: 1000px;
    height: 660px;
    padding: 34px 56px 30px 56px;
    background-color: #17131B;
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 4px;
    opacity: 0;
    translate: 0 50px;
    scale: 0.94 0.94;
    transition: opacity 0.28s ease-out, translate 0.38s ease-out-back, scale 0.38s ease-out-back;
}

.frame--narrow {
    width: 760px;
}

/* How to Play: the piece list needs the room. Fits down to 5:4 screens at the 1920x1080 reference. */
.frame--tall {
    height: 900px;
}

.panel--open .frame {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.stud {
    position: absolute;
    width: 16px;
    height: 16px;
    rotate: 45deg;
    background-color: var(--blood);
    border-width: 2px;
    border-color: var(--gold);
}

.stud--tl { left: -9px; top: -9px; }
.stud--tr { right: -9px; top: -9px; }
.stud--bl { left: -9px; bottom: -9px; }
.stud--br { right: -9px; bottom: -9px; }

.panel-title {
    -unity-font-definition: url("Fonts/CinzelDecorative-Black.ttf");
    font-size: 48px;
    color: var(--gold);
    -unity-text-align: middle-center;
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.8);
    margin: 0 0 18px 0;
    padding: 0;
}

.panel-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 22px;
}

.small-btn {
    height: 46px;
    min-width: 150px;
    margin: 0 0 0 14px;
    padding: 0 24px;
    -unity-font-definition: url("Fonts/Cinzel-ExtraBold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--text);
    background-color: rgba(92, 24, 20, 0.92);
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 3px;
    transition: background-color 0.15s ease-out, color 0.15s ease-out, scale 0.1s ease-out, translate 0.15s ease-out;
}

.small-btn:hover, .small-btn:focus {
    background-color: rgba(140, 34, 26, 0.96);
    color: var(--gold-hi);
    translate: 0 -2px;
}

.small-btn:active { scale: 0.96 0.96; }

.small-btn--quiet {
    background-color: rgba(42, 36, 48, 0.9);
    border-color: var(--edge);
    color: var(--muted);
}

.small-btn--quiet:hover, .small-btn--quiet:focus {
    background-color: rgba(64, 54, 72, 0.95);
    border-color: var(--gold);
}

/* ---------- Settings ---------- */

.tabs {
    flex-direction: row;
    justify-content: center;
    border-bottom-width: 2px;
    border-color: rgba(74, 66, 80, 0.7);
    margin-bottom: 26px;
}

.tab {
    min-width: 200px;
    height: 48px;
    margin: 0;
    -unity-font-definition: url("Fonts/Cinzel-ExtraBold.ttf");
    font-size: 20px;
    letter-spacing: 4px;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    transition: color 0.2s ease-out;
}

.tab:hover, .tab:focus { color: var(--text); }
.tab--active { color: var(--gold-hi); }

.tab-underline {
    position: absolute;
    bottom: -2px;
    height: 3px;
    background-color: var(--gold);
    transition: left 0.3s ease-out-cubic, width 0.3s ease-out-cubic;
}

.pages {
    flex-grow: 1;
}

.page {
    display: none;
    opacity: 0;
    translate: 24px 0;
    transition: opacity 0.25s ease-out, translate 0.3s ease-out-cubic;
}

.page--shown { display: flex; }
.page--in { opacity: 1; translate: 0 0; }

.setting {
    height: 56px;
    margin: 0 0 6px 0;
    padding: 0 16px;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
}

.setting:hover { background-color: rgba(217, 164, 65, 0.08); }

.setting > .unity-base-field__label, .setting .unity-label {
    min-width: 330px;
    width: 330px;
    font-size: 20px;
    color: var(--text);
    -unity-text-align: middle-left;
}

.value-label {
    min-width: 80px;
    margin-left: 16px;
    -unity-text-align: middle-right;
    font-size: 18px;
    color: var(--gold-hi);
}

.setting > .unity-base-field__input {
    flex-grow: 1;
}

.setting .unity-base-slider__tracker {
    height: 10px;
    margin-top: -5px;
    background-color: var(--ink);
    border-color: var(--edge);
    border-radius: 5px;
}

.setting .unity-base-slider__fill {
    background-color: var(--blood);
    border-radius: 5px;
}

.setting .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: 11px;
    background-color: var(--gold);
    border-color: var(--gold-hi);
    border-width: 2px;
    transition: scale 0.15s ease-out-back;
}

.setting .unity-base-slider__dragger:hover { scale: 1.25 1.25; }

.unity-base-popup-field__input {
    height: 38px;
    background-color: var(--ink);
    border-color: var(--edge);
    border-width: 2px;
    border-radius: 3px;
    color: var(--text);
    font-size: 18px;
}

.unity-base-popup-field__input:hover { border-color: var(--gold); }

.unity-base-dropdown__container-inner {
    background-color: #17131B;
    border-color: var(--gold);
    border-width: 2px;
}

.unity-base-dropdown__item { height: 34px; }
.unity-base-dropdown__label { color: var(--text); font-size: 17px; }
.unity-base-dropdown__item:hover { background-color: rgba(217, 164, 65, 0.25); }

.unity-toggle__checkmark {
    width: 28px;
    height: 28px;
    background-color: var(--ink);
    border-color: var(--gold);
    border-width: 2px;
    border-radius: 3px;
    -unity-background-image-tint-color: var(--gold-hi);
}

.bindings {
    margin-top: 6px;
}

#reset-bindings {
    align-self: flex-end;
    margin: 8px 0 0 0;
}

.binding-row {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin-bottom: 4px;
    padding: 0 16px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
}

.binding-name {
    flex-grow: 1;
    font-size: 20px;
    margin: 0;
    padding: 0;
}

.key-btn {
    min-width: 230px;
    height: 40px;
    margin: 0;
    -unity-font-definition: url("Fonts/Cinzel-ExtraBold.ttf");
    font-size: 17px;
    letter-spacing: 2px;
    color: var(--gold-hi);
    background-color: var(--ink);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 3px;
    transition: border-color 0.2s ease-out, background-color 0.2s ease-out, color 0.2s ease-out;
}

.key-btn:hover, .key-btn:focus { border-color: var(--gold); }

.key-btn--listening {
    color: var(--text);
    border-color: var(--blood);
    background-color: rgba(120, 30, 24, 0.6);
}

/* ---------- Levels ---------- */

.level-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.level-tile {
    width: 100px;
    height: 124px;
    margin: 6px 3px;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--stone);
    border-width: 2px;
    border-color: var(--edge);
    border-radius: 4px;
    transition: opacity 0.3s ease-out, scale 0.35s ease-out-back, border-color 0.15s ease-out, background-color 0.15s ease-out, translate 0.15s ease-out;
}

.level-tile:hover, .level-tile:focus {
    border-color: var(--gold);
    background-color: var(--stone-hi);
    translate: 0 -4px;
}

.level-num {
    -unity-font-definition: url("Fonts/CinzelDecorative-Black.ttf");
    font-size: 44px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.level-state {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
    margin: 0;
    padding: 0;
}

.level-best {
    font-size: 11px;
    color: var(--gold-hi);
    margin: 4px 0 0 0;
    padding: 0;
}

.level-tile--done { border-color: var(--gold); }
.level-tile--done .level-state { color: #7BD389; }

.level-tile--locked { opacity: 0.45; }
.level-tile--locked:hover { translate: 0 0; border-color: var(--edge); background-color: var(--stone); }

/* ---------- How to Play ---------- */

.steps {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
}

.step {
    width: 280px;
    padding: 22px 20px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: var(--edge);
    border-top-width: 3px;
    border-top-color: var(--blood);
    border-radius: 3px;
}

.step-num {
    -unity-font-definition: url("Fonts/CinzelDecorative-Black.ttf");
    font-size: 54px;
    color: var(--gold);
    margin: 0;
    padding: 0;
}

.step-title {
    -unity-font-definition: url("Fonts/Cinzel-ExtraBold.ttf");
    font-size: 21px;
    letter-spacing: 2px;
    margin: 0 0 10px 0;
    padding: 0;
}

.step-body {
    font-size: 17px;
    color: var(--muted);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.pieces {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 18px;
}

.pieces-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

/* Thin themed scrollbar: no arrow buttons, a gold thumb on a dark track. */
.pieces .unity-scroller--vertical { width: 8px; margin-left: 8px; }
.pieces .unity-scroller__low-button, .pieces .unity-scroller__high-button { display: none; }
.pieces .unity-base-slider__tracker { background-color: var(--ink); border-width: 0; border-radius: 4px; }
.pieces .unity-base-slider__dragger { background-color: var(--gold); border-width: 0; border-radius: 4px; }
.pieces .unity-base-slider__drag-container { margin: 0; }

.piece {
    width: 428px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: var(--edge);
    border-left-width: 3px;
    border-left-color: var(--gold);
    border-radius: 3px;
}

.piece-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-right: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.piece-icon--potion { background-image: url("../Art/Kenney/TinyDungeon/tile_0116.png"); }
.piece-icon--sleep { background-image: url("../Art/Kenney/TinyDungeon/tile_0114.png"); }
.piece-icon--recall { background-image: url("../Art/Kenney/TinyDungeon/tile_0113.png"); -unity-background-image-tint-color: rgb(191, 128, 255); }
.piece-icon--rage { background-image: url("../Art/Kenney/TinyDungeon/tile_0115.png"); }
.piece-icon--stone { background-image: url("../Art/Kenney/TinyDungeon/tile_0113.png"); }
.piece-icon--dwarf { background-image: url("../Art/Kenney/TinyDungeon/tile_0087.png"); }
.piece-icon--brute { background-image: url("../Art/Kenney/TinyDungeon/tile_0086.png"); }
.piece-icon--wizard { background-image: url("../Art/Kenney/TinyDungeon/tile_0084.png"); }
.piece-icon--thief { background-image: url("../Art/Kenney/TinyDungeon/tile_0111.png"); }
.piece-icon--hunter { background-image: url("../Art/Kenney/TinyDungeon/tile_0088.png"); }
.piece-icon--ward { background-image: url("../Art/Kenney/TinyDungeon/tile_0042.png"); }

.piece-text {
    flex-shrink: 1;
}

/* ---------- Credits ---------- */

.credits {
    align-items: center;
}

.credit-role {
    font-size: 15px;
    letter-spacing: 4px;
    color: var(--gold);
    margin: 18px 0 2px 0;
    padding: 0;
}

.credit-name {
    -unity-font-definition: url("Fonts/Cinzel-ExtraBold.ttf");
    font-size: 30px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.credit-name--small {
    font-size: 19px;
}

/* Keyboard and gamepad focus: gold instead of the default theme's blue ring. */
.root .unity-button:focus {
    border-color: var(--gold-hi);
}

/* ---------- Shared overlay and pause screen ---------- */

/* A <ui:Instance> of Settings.uxml: fill the screen without blocking clicks itself. */
.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hud-buttons {
    position: absolute;
    top: 18px;
    right: 18px;
    flex-direction: row;
}

.help-btn { margin: 0; }
.pause-btn { margin: 0 0 0 14px; }

.frame--pause {
    width: 620px;
    height: auto;
    min-height: 0;
}

.pause-info {
    -unity-text-align: middle-center;
    font-size: 17px;
    letter-spacing: 2px;
    color: var(--muted);
    margin: -6px 0 26px 0;
    padding: 0;
}

.pause-buttons {
    align-items: flex-start;
}

/* ---------- In-level HUD ---------- */

.hint {
    position: absolute;
    left: 36px;
    top: 36px;
    width: 380px;
    padding: 20px 24px 22px 24px;
    background-color: var(--stone);
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 4px;
    transition: opacity 0.3s ease-out, translate 0.35s ease-out-back;
}

.hint--hidden {
    opacity: 0;
    translate: -40px 0;
}

.hint-head {
    flex-direction: row;
    align-items: center;
    margin: 0 0 10px 0;
}

.hint-title {
    -unity-font-definition: url("Fonts/CinzelDecorative-Black.ttf");
    font-size: 24px;
    color: var(--gold);
    white-space: normal;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}

/* The new-piece card's picture of the piece. */
.hint-icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.hint-text {
    font-size: 19px;
    color: var(--text);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.hint-btn {
    align-self: flex-end;
    margin: 16px 0 0 0;
    min-width: 120px;
}

.keys {
    position: absolute;
    left: 36px;
    bottom: 24px;
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--muted);
    margin: 0;
    padding: 0;
}

.result-body {
    white-space: normal;
    font-size: 19px;
}


/* ---------- Stars, credits roll ---------- */

.stars {
    flex-direction: row;
    justify-content: center;
    margin: 2px 0 10px 0;
}

.star { transition: scale 0.3s ease-out-back; }

.level-stars {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}

.stars-total {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin: -10px 0 14px 0;
}

.stars-total > Label {
    font-size: 20px;
    color: var(--gold-hi);
    margin: 0 0 0 4px;
    padding: 0;
}

.roll {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    overflow: hidden;
    background-color: #0B0A0E;
}

.roll-text {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
}

.roll-title { font-size: 84px; margin-bottom: 40px; }
.roll-thanks { font-size: 56px; margin-top: 80px; }

.roll-hero {
    position: absolute;
    bottom: 60px;
    width: 96px;
    height: 96px;
    rotate: 8deg; /* head down */
}
