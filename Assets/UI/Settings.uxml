<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- The Settings panel, included by MainMenu.uxml and PauseMenu.uxml. Logic: SettingsPanel.cs. -->
    <ui:VisualElement name="settings-panel" class="panel">
        <ui:VisualElement class="frame">
            <ui:VisualElement class="stud stud--tl" /><ui:VisualElement class="stud stud--tr" /><ui:VisualElement class="stud stud--bl" /><ui:VisualElement class="stud stud--br" />
            <ui:Label text="#settings.title" class="panel-title" />
            <ui:VisualElement class="tabs">
                <ui:Button name="tab-audio" text="#settings.audio" class="tab" />
                <ui:Button name="tab-graphics" text="#settings.graphics" class="tab" />
                <ui:Button name="tab-controls" text="#settings.controls" class="tab" />
                <ui:VisualElement name="tab-underline" class="tab-underline" />
            </ui:VisualElement>
            <ui:VisualElement class="pages">
                <ui:VisualElement name="page-audio" class="page">
                    <ui:Slider name="vol-master" label="#settings.master" low-value="0" high-value="1" class="setting" />
                    <ui:Slider name="vol-music" label="#settings.music" low-value="0" high-value="1" class="setting" />
                    <ui:Slider name="vol-sfx" label="#settings.sfx" low-value="0" high-value="1" class="setting" />
                </ui:VisualElement>
                <ui:VisualElement name="page-graphics" class="page">
                    <ui:DropdownField name="gfx-quality" label="#settings.quality" class="setting" />
                    <ui:DropdownField name="gfx-resolution" label="#settings.resolution" class="setting" />
                    <ui:Toggle name="gfx-fullscreen" label="#settings.fullscreen" class="setting" />
                    <ui:Toggle name="gfx-vsync" label="#settings.vsync" class="setting" />
                </ui:VisualElement>
                <ui:VisualElement name="page-controls" class="page">
                    <ui:Slider name="mouse-sens" label="#settings.sensitivity" low-value="0.2" high-value="3" class="setting" />
                    <ui:VisualElement name="bindings" class="bindings" />
                    <ui:Button name="reset-bindings" text="#settings.reset" class="small-btn small-btn--quiet" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-footer"><ui:Button name="settings-back" text="#back" class="small-btn back-btn" /></ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
